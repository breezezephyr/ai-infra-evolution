  "findings": [
    {
      "id": "F1",
      "priority": "P1",
      "title": "Same-host wall-clock discontinuities contaminate engine timing despite no cross-host subtraction",
      "locations": [
        {
          "file": "phase5/exp22/measure.py",
          "line": 57,
          "end_line": 65
        },
        {
          "file": "phase5/exp22/analyze.py",
          "line": 55,
          "end_line": 56
        },
        {
          "file": "phase5/exp22/analyze.py",
          "line": 77,
          "end_line": 79
        },
        {
          "file": "phase5/exp22/backend_audit.py",
          "line": 49,
          "end_line": 54
        }
      ],
      "observed": "Backend RequestMetrics epoch-valued finished-arrival and finished-first_scheduled intervals are trusted without checking against available backend monotonic audit events. Four wall-minus-monotonic offset increases of 2.280-2.395 seconds appear across the run; three occur within requests. No cause such as NTP, manual clock adjustment or suspend can be identified from these files alone.",
      "evidence": "exp22-formal-v1-b10-i7 reports engine total 4339.154ms, but engine_request->engine_finished on the same backend monotonic clock is 2059.046ms, API ingress->finished is 2065.750ms and client complete response is 2378.437ms. b03-i5 and b15-i3 have the same contradiction. Detailed IDs and recomputation are in secondary.clock_anomalies.",
      "impact": "Raw total_ms and scheduled_to_finish_ms for those 3 requests, plus their group summaries, are invalid duration evidence. direct/1 raw scheduled_to_finish p95 is 3990.848ms. The separately labelled existing-audit monotonic schedule-plan->engine-finished observation yields p95 2026.351ms for all 24 direct/1 requests. bounded/1 median changes from 1496.652ms raw to 953.476ms for the separately labelled monotonic observation.",
      "unaffected": "144-request identity/output counts; local client/gateway monotonic spans; local batch makespans; the article's concurrency-4 table. No >2ms first-token monotonic-bound violation was found, but existing first-token wall timings do not have a direct monotonic first-token event.",
      "minimal_fix": [
        "Mark timing_issues separately from request/output validity; retain all 144 in request/output denominators.",
        "Immediately stop publishing affected wall-duration aggregates. Existing scheduler_plan and engine_finished backend_monotonic_ns can provide observed_schedule_plan_to_engine_finished_ms under that explicit label, preserving all 144 observations.",
        "If excluding the 3 affected legacy-duration observations instead, report n=22 for direct/1 and n=23 for bounded/1, and disclose the changed task/length mixture; do not silently substitute them as an unbiased corrected sample.",
        "For exact queue/first-token/finished durations in a later run, instrument all boundaries with one backend monotonic clock and pair with wall time only for correlation; add clock-discontinuity sanity checks.",
        "Do not silently subtract an inferred clock jump, clamp a duration or call any host interval pure GPU kernel time."
      ],
      "article_minimal_fix": "At the current article timing paragraph, disclose that 3 engine total/scheduled-to-finish observations contain wall-clock discontinuities and are excluded from performance conclusions. The current concurrency-4 table may remain."
    },
